# ReliefOS Express API (system of record)
RELIEFOS_API_URL=http://localhost:4000/api
# Must equal RELIEFOS_AGENT_TOKEN in server/.env. Lets agents create drafts, proposals and reports,
# never approve, pay or confirm deliveries.
RELIEFOS_AGENT_TOKEN=

# MCP access tokens for Streamable HTTP clients (/mcp):
#   full scope (read + write tools) and read-only scope (read tools only).
RELIEFOS_MCP_TOKEN=
RELIEFOS_MCP_READONLY_TOKEN=
# Scope granted to local stdio clients (Claude Code / Claude Desktop / MCP Inspector): read | write
MCP_STDIO_SCOPE=write

# Service
AGENTS_HOST=127.0.0.1
AGENTS_PORT=8001

# Optional LLM for agent explanations. Without one, agents still run fully and explanations are
# reported as unavailable. Nothing numeric ever comes from the LLM.
# Free OpenAI-compatible options: gemini | groq | cerebras | openrouter  (LLM_MODEL/LLM_BASE_URL optional)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Or Anthropic:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# How agents reach the MCP tools: memory (in-process MCP session, default) or http (MCP_CLIENT_URL)
MCP_CLIENT_TRANSPORT=memory
MCP_CLIENT_URL=
