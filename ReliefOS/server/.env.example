# Neon PostgreSQL (system of record). Never run `prisma migrate reset` against it.
DATABASE_URL=
PORT=4000
CLIENT_URL=http://localhost:5173

# PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://localhost:5173/payments/success
PAYPAL_CANCEL_URL=http://localhost:5173/payments/cancel
# developer.paypal.com > your app > Webhooks. Subscribe to PAYMENT.CAPTURE.COMPLETED / DENIED / REFUNDED
# and point it at https://<public-tunnel>/api/webhooks/paypal (e.g. ngrok http 4000).
PAYPAL_WEBHOOK_ID=

# Human coordinator credential: approvals, PayPal checkout/capture, real failure reports,
# delivery status and NGO receipts. Empty = auth disabled (local development only).
RELIEFOS_COORDINATOR_TOKEN=
# Agent service credential (python-services RELIEFOS_AGENT_TOKEN must match). Agents may create
# drafts, proposals, validation reports, workflow traces and SIMULATED failures — nothing else.
RELIEFOS_AGENT_TOKEN=
