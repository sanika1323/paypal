
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  NGO
  GOVERNMENT
  SUPPLIER
}

enum RequestStatus {
  PENDING
  VERIFIED
  CONSOLIDATED
  APPROVED
  FULFILLED
  REJECTED
}

enum ProcurementStatus {
  DRAFT
  ANALYZING
  PENDING_APPROVAL
  APPROVED
  ORDERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  DELAYED
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  type        OrganizationType
  email       String        @unique
  location    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  requests    ReliefRequest[]
  allocations Allocation[]
}

model Emergency {
  id          String        @id @default(cuid())
  name        String
  description String?
  location    String
  severity    String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  requests    ReliefRequest[]
  plans       ProcurementPlan[]
}

model Product {
  id          String        @id @default(cuid())
  name        String        @unique
  category    String
  unit        String
  createdAt   DateTime      @default(now())

  requests    ReliefRequest[]
  offers      VendorOffer[]
}

model ReliefRequest {
  id             String        @id @default(cuid())
  organizationId String
  emergencyId    String
  productId      String
  quantity       Int
  urgency        Int           @default(3)
  status         RequestStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  emergency      Emergency     @relation(fields: [emergencyId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
}

model Vendor {
  id          String        @id @default(cuid())
  name        String
  location    String
  email       String?
  reliability Float         @default(0)
  createdAt   DateTime      @default(now())

  offers      VendorOffer[]
}

model VendorOffer {
  id           String    @id @default(cuid())
  vendorId     String
  productId    String
  unitPrice    Decimal   @db.Decimal(12, 2)
  capacity     Int
  deliveryDays Int
  createdAt    DateTime  @default(now())

  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])
}

model ProcurementPlan {
  id          String            @id @default(cuid())
  emergencyId String
  name        String
  totalBudget Decimal           @db.Decimal(14, 2)
  status      ProcurementStatus @default(DRAFT)
  explanation String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  emergency   Emergency         @relation(fields: [emergencyId], references: [id])
  allocations Allocation[]
  approvals   Approval[]
  payments    Payment[]
}

model Allocation {
  id             String          @id @default(cuid())
  planId         String
  organizationId String
  quantity       Int
  amount         Decimal         @db.Decimal(12, 2)

  plan           ProcurementPlan @relation(fields: [planId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
}

model Approval {
  id          String          @id @default(cuid())
  planId      String
  approvedBy  String
  approved    Boolean         @default(false)
  comments    String?
  createdAt   DateTime        @default(now())

  plan        ProcurementPlan @relation(fields: [planId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  planId         String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  paypalOrderId  String?       @unique
  paypalCaptureId String?      @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  plan           ProcurementPlan @relation(fields: [planId], references: [id])
  deliveries     Delivery[]
}

model Delivery {
  id          String         @id @default(cuid())
  paymentId   String
  trackingRef String?
  destination String
  quantity    Int
  status      DeliveryStatus @default(PENDING)
  estimatedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())

  payment     Payment        @relation(fields: [paymentId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
}
