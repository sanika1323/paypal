generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  NGO
  GOVERNMENT
  SUPPLIER
}

enum RequestStatus {
  PENDING
  VERIFIED
  CONSOLIDATED
  APPROVED
  FULFILLED
  REJECTED
}

enum ProcurementStatus {
  DRAFT
  ANALYZING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  DELAYED
  FAILED
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType
  email     String           @unique
  location  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  requests    ReliefRequest[]
  allocations Allocation[]
}

model Emergency {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String
  severity    String
  isActive    Boolean  @default(true)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  requests ReliefRequest[]
  plans    ProcurementPlan[]
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  unit      String
  createdAt DateTime @default(now())

  requests  ReliefRequest[]
  offers    VendorOffer[]
  planItems ProcurementPlanItem[]
}

model ReliefRequest {
  id             String        @id @default(cuid())
  organizationId String
  emergencyId    String
  productId      String
  quantity       Int
  urgency        Int           @default(3)
  status         RequestStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  emergency    Emergency    @relation(fields: [emergencyId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  allocations  Allocation[]
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  location    String
  email       String?
  reliability Float    @default(0)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  offers          VendorOffer[]
  failureEvents   SupplierFailureEvent[]
}

model VendorOffer {
  id           String   @id @default(cuid())
  vendorId     String
  productId    String
  unitPrice    Decimal  @db.Decimal(12, 2)
  capacity     Int
  deliveryDays Int
  isAvailable  Boolean   @default(true)
  validUntil   DateTime?
  createdAt    DateTime  @default(now())

  vendor        Vendor                 @relation(fields: [vendorId], references: [id])
  product       Product                @relation(fields: [productId], references: [id])
  purchases     ProcurementPurchase[]
  failureEvents SupplierFailureEvent[]
}

model ProcurementPlan {
  id          String            @id @default(cuid())
  emergencyId String
  name        String
  totalBudget Decimal           @db.Decimal(14, 2)
  status      ProcurementStatus @default(DRAFT)
  explanation String?
  version     Int               @default(1)
  revisionOfId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  revisionOf  ProcurementPlan?  @relation("PlanRevisions", fields: [revisionOfId], references: [id])
  revisions   ProcurementPlan[] @relation("PlanRevisions")
  failureEvents      SupplierFailureEvent[]
  sourceProposals    ReplanningProposal[]   @relation("ProposalSource")
  committedProposal  ReplanningProposal?    @relation("ProposalCommitted")

  emergency   Emergency             @relation(fields: [emergencyId], references: [id])
  allocations Allocation[]
  approvals   Approval[]
  payments    Payment[]
  totalCost   Decimal               @default(0) @db.Decimal(14, 2)
  items       ProcurementPlanItem[]
}

model Allocation {
  id              String  @id @default(cuid())
  planId          String
  organizationId  String
  quantity        Int
  amount          Decimal @db.Decimal(12, 2)
  reliefRequestId String?
  planItemId      String?

  plan          ProcurementPlan      @relation(fields: [planId], references: [id])
  organization  Organization         @relation(fields: [organizationId], references: [id])
  reliefRequest ReliefRequest?       @relation(fields: [reliefRequestId], references: [id])
  planItem      ProcurementPlanItem? @relation(fields: [planItemId], references: [id])
  deliveries    Delivery[]
}

model Approval {
  id         String   @id @default(cuid())
  planId     String
  approvedBy String
  approved   Boolean  @default(false)
  comments   String?
  createdAt  DateTime @default(now())

  plan ProcurementPlan @relation(fields: [planId], references: [id])
}

model Payment {
  id                  String        @id @default(cuid())
  planId              String
  amount              Decimal       @db.Decimal(14, 2)
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  paypalOrderId       String?       @unique
  paypalCaptureId     String?       @unique

  // Original procurement value and dated conversion snapshot
  originalAmountINR   Decimal?      @db.Decimal(14, 2)
  exchangeRate        Decimal?      @db.Decimal(18, 10)
  exchangeRateDate    String?
  exchangeRateProvider String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  plan                ProcurementPlan @relation(fields: [planId], references: [id])
  deliveries          Delivery[]
}
model Delivery {
  id                    String         @id @default(cuid())
  paymentId             String?
  procurementPurchaseId String?
  allocationId          String?
  trackingRef           String?
  destination           String
  quantity              Int
  status                DeliveryStatus @default(PENDING)
  estimatedAt           DateTime?
  deliveredAt           DateTime?
  failureReason         String?
  dispatchedQuantity    Int            @default(0)
  deliveredQuantity     Int            @default(0)
  delayReason           String?
  receivedBy            String?
  receivedAt            DateTime?
  receiptNotes          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  payment             Payment?             @relation(fields: [paymentId], references: [id])
  procurementPurchase ProcurementPurchase? @relation(fields: [procurementPurchaseId], references: [id])
  allocation          Allocation?          @relation(fields: [allocationId], references: [id])
  failureEvents       SupplierFailureEvent[]
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
}

model ProcurementPlanItem {
  id                  String   @id @default(cuid())
  planId              String
  productId           String
  requestedQuantity   Int
  purchasedQuantity   Int
  unfulfilledQuantity Int
  unit                String
  createdAt           DateTime @default(now())

  plan        ProcurementPlan       @relation(fields: [planId], references: [id])
  product     Product               @relation(fields: [productId], references: [id])
  purchases   ProcurementPurchase[]
  allocations Allocation[]
}

model ProcurementPurchase {
  id            String   @id @default(cuid())
  planItemId    String
  vendorOfferId String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)
  deliveryDays  Int
  createdAt     DateTime @default(now())

  planItem    ProcurementPlanItem @relation(fields: [planItemId], references: [id])
  vendorOffer VendorOffer         @relation(fields: [vendorOfferId], references: [id])
  deliveries  Delivery[]
}

// ---------------------------------------------------------------------------
// Replanning, revalidation and agent workflows (additive, 2026-11-12)
// ---------------------------------------------------------------------------

enum SupplierFailureType {
  ORDER_CANCELLED
  INSUFFICIENT_STOCK
  CAPACITY_REDUCED
  SUPPLIER_UNAVAILABLE
  OFFER_EXPIRED
  PRICE_CHANGED
  DELIVERY_DELAYED
  WHAT_IF_SCENARIO
}

enum ProposalMode {
  REPLACEMENT
  AMENDMENT
}

enum ProposalStatus {
  DRAFT
  VALIDATED
  VALIDATED_WITH_WARNINGS
  REQUIRES_HUMAN_REVIEW
  REJECTED_INFEASIBLE
  REJECTED_STALE_DATA
  REJECTED_VERSION_CONFLICT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ValidationOutcome {
  VALIDATED
  VALIDATED_WITH_WARNINGS
  REJECTED_INFEASIBLE
  REJECTED_STALE_DATA
  REJECTED_VERSION_CONFLICT
  REQUIRES_HUMAN_REVIEW
}

enum WorkflowStatus {
  RUNNING
  WAITING_FOR_HUMAN
  COMPLETED
  FAILED
}

enum StepKind {
  AI_REASONING
  MCP_TOOL
  DETERMINISTIC
  PERSISTED_MUTATION
  SIMULATION
  HUMAN_ACTION
}

model SupplierFailureEvent {
  id                   String              @id @default(cuid())
  type                 SupplierFailureType
  vendorId             String
  vendorOfferId        String?
  planId               String?
  deliveryId           String?
  affectedQuantity     Int?
  reportedCapacity     Int?
  reportedUnitPrice    Decimal?            @db.Decimal(12, 2)
  reportedDeliveryDays Int?
  reason               String
  isSimulation         Boolean             @default(false)
  reportedBy           String
  idempotencyKey       String?             @unique
  createdAt            DateTime            @default(now())

  vendor      Vendor               @relation(fields: [vendorId], references: [id])
  vendorOffer VendorOffer?         @relation(fields: [vendorOfferId], references: [id])
  plan        ProcurementPlan?     @relation(fields: [planId], references: [id])
  delivery    Delivery?            @relation(fields: [deliveryId], references: [id])
  proposals   ReplanningProposal[]
}

model ReplanningProposal {
  id                String         @id @default(cuid())
  workflowId        String?
  mode              ProposalMode
  status            ProposalStatus @default(DRAFT)
  sourcePlanId      String
  sourcePlanVersion Int
  failureEventId    String?
  isSimulation      Boolean        @default(false)
  budget            Decimal        @db.Decimal(14, 2)
  maxDeliveryDays   Int?
  scenario          Json
  candidate         Json
  comparison        Json
  inputFingerprint  String
  rationale         String?
  createdBy         String
  decidedBy         String?
  decisionComment   String?
  decidedAt         DateTime?
  committedPlanId   String?        @unique
  idempotencyKey    String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sourcePlan    ProcurementPlan       @relation("ProposalSource", fields: [sourcePlanId], references: [id])
  committedPlan ProcurementPlan?      @relation("ProposalCommitted", fields: [committedPlanId], references: [id])
  failureEvent  SupplierFailureEvent? @relation(fields: [failureEventId], references: [id])
  validations   ValidationReport[]
}

model ValidationReport {
  id               String             @id @default(cuid())
  proposalId       String
  workflowId       String?
  outcome          ValidationOutcome
  agentOutcome     ValidationOutcome?
  validator        String
  checks           Json
  recomputed       Json?
  inputFingerprint String
  createdAt        DateTime           @default(now())

  proposal ReplanningProposal @relation(fields: [proposalId], references: [id])
}

model AgentWorkflow {
  id             String         @id @default(cuid())
  type           String
  status         WorkflowStatus @default(RUNNING)
  trigger        String
  emergencyId    String?
  planId         String?
  proposalId     String?
  failureEventId String?
  isSimulation   Boolean        @default(false)
  state          Json
  checkpoint     String?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps AgentStep[]
}

model AgentStep {
  id            String   @id @default(cuid())
  workflowId    String
  sequence      Int
  agent         String
  kind          StepKind
  tool          String?
  status        String
  inputSummary  Json?
  outputSummary Json?
  error         String?
  attempt       Int      @default(1)
  correlationId String?
  startedAt     DateTime
  durationMs    Int
  createdAt     DateTime @default(now())

  workflow AgentWorkflow @relation(fields: [workflowId], references: [id])

  @@unique([workflowId, sequence])
}

model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now())
}

